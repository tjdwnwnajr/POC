--- !u!114 &1788769834
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1788769833}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 29132fe69a9032d4faf18daa8cb775c1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogSystem
  speakers:
  - spriteRenderer: {fileID: 122323227}
    imageDialog: {fileID: 8854019615307694713}
    textName: {fileID: 5609098539307908221}
    textDialogue: {fileID: 7582375841485984880}
    objectArrow: {fileID: 2966384961738756441}
  dialogs:
  - speakerIndex: 0
    name: "\uC601\uAC10\uB2D8"
    dialogue: "\uC5F4\uC1E0...? \uC124\uB9C8 \uD0C8\uCD9C\uC744 \uC0DD\uAC01\uD558\uB294
      \uAC74\uAC00?\n\uB2E4 \uD5C8\uD2BC \uC9D3\uC77C\uD150\uB370..\n"
  - speakerIndex: 0
    name: "\uC601\uAC10\uB2D8"
    dialogue: "\uC9C0\uAE08\uAE4C\uC9C0 \uAFC8 \uC18D\uC5D0\uC11C \uC5F4\uC1E0\uB97C
      \uCC3E\uC544 \uC0B4\uC544\uB3CC\uC544\uC628 \uC0AC\uB78C\uC740 \uB098\uBC16\uC5D0
      \uC5C6\uC5B4.\n\uC0B4\uC544\uB3CC\uC544\uC640\uB3C4.."
  - speakerIndex: 0
    name: "\uB098"
    dialogue: "\uC601\uAC10\uB2D8, \uC545\uBABD \uB54C\uBB38\uC5D0.. \uBBF8\uCCD0\uBC84\uB9AC\uACA0\uC5B4\uC694...\n\uC774\uB807\uAC8C
      \uC0AC\uB294\uAC74 \uC0AC\uB294\uAC8C \uC544\uB2C8\uB77C\uACE0\uC694."
  - speakerIndex: 0
    name: "\uC601\uAC10\uB2D8"
    dialogue: "\uC5F4\uC1E0\uAC00 \uACFC\uC5F0 \uC790\uB124\uC758 \uC545\uBABD\uC744
      \uD574\uACB0\uD574\uC904 \uAC83 \uAC19\uB098..."
  - speakerIndex: 0
    name: "\uB098"
    dialogue: "\uD56D\uC0C1 \uADF8.. \uADF8 \uBB38 \uC55E\uC5D0\uC11C \uAE68\uC5B4\uB09C\uB2E8
      \uB9D0\uC774\uC5D0\uC694!"
  - speakerIndex: 0
    name: "\uC601\uAC10\uB2D8"
    dialogue: "\uAFC8 \uC18D\uC740 \uAD49\uC7A5\uD788 \uC704\uD5D8\uD560\uD14C\uC57C.
      \uC5F4\uC1E0\uB97C \uCC3E\uB294\uAC74 \uB3C4\uC640\uC8FC\uC9C0.\n\uC120\uD0DD\uC740
      \uC790\uB124\uC758 \uCC45\uC784\uC774\uC57C."
  - speakerIndex: 0
    name: "\uC601\uAC10\uB2D8"
    dialogue: "\uC774\uAC10\uC625\uC5D0\uB294 \uAFC8\uC73C\uB85C \uB4E4\uC5B4\uAC00\uB294
      \uB450\uAC1C\uC758 \uBC29\uC774 \uC788\uB124.\r\n\uADF8\uACF3\uC5D0\uC11C \uAFC8
      \uC18D \uC138\uC0C1\uC73C\uB85C \uB118\uC5B4\uAC00 \uC5F4\uC1E0\uB97C \uCC3E\uC544\uBCF4\uAC8C."
  - speakerIndex: 0
    name: "\uC601\uAC10\uB2D8"
    dialogue: "\uC5F4\uC1E0\uB97C \uCC3E\uB294\uB2E4\uD574\uB3C4..\uC544\uB2D0\uC138
      .\r\n\uB098\uB97C \uC6D0\uB9DD\uD558\uC9C0 \uB9D0\uAC8C\uB098."
  - speakerIndex: 0
    name: "\uC601\uAC10\uB2D8"
    dialogue: "(\uC774\uBC88\uC5D0\uB294 \uB2E4\uB97C\uB824\uB098...)"
  typingSpeed: 0.05
  playerMovementScript: {fileID: 8649242032808169886}
  nextUI: {fileID: 5446249984446706651}
